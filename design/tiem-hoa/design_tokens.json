{
  "$meta": {
    "name": "Tiệm Hoa – design tokens",
    "version": "0.2.0-xanh",
    "author": "Phú",
    "frame": {
      "width": 360,
      "height": 640,
      "note": "Logical px in Khoa's fixed portrait frame. Scale uniformly with the frame."
    },
    "status": "Đề xuất tông xanh (Phú, 26/9). occasion và temple giữ nguyên."
  },
  "color": {
    "bg": {
      "base": "#F8F5EA",
      "shop": "#E9F2E1",
      "overlay": "#2E3A2C73"
    },
    "surface": {
      "card": "#FFFFFF",
      "sunken": "#F1F4E8",
      "border": "#DCE5D0",
      "borderStrong": "#BCCDB0"
    },
    "primary": {
      "base": "#3F7F52",
      "pressed": "#2F6340",
      "soft": "#DCEFD9",
      "onPrimary": "#FFFFFF"
    },
    "secondary": {
      "base": "#F2A477",
      "pressed": "#D9825A",
      "soft": "#FDE6D6",
      "onSecondary": "#4A2B1E"
    },
    "accent": {
      "base": "#F5C451",
      "soft": "#FDEFC6"
    },
    "text": {
      "primary": "#43392F",
      "secondary": "#6E6455",
      "disabled": "#BDB5A6",
      "inverse": "#FFFFFF"
    },
    "freshness": {
      "fresh": "#5DB58C",
      "aging": "#F5C451",
      "wilting": "#E26D5A",
      "track": "#E6ECDD"
    },
    "match": {
      "low": "#E26D5A",
      "ok": "#F5C451",
      "perfect": "#5DB58C"
    },
    "status": {
      "success": "#1F7F66",
      "warning": "#E0A030",
      "danger": "#C94F3A",
      "info": "#4F8FB5"
    },
    "currency": {
      "coin": "#F2B632",
      "star": "#F5C451"
    },
    "occasion": {
      "birthday": "#F4A6C0",
      "opening": "#F5C451",
      "wedding": "#FFFFFF",
      "confession": "#E8738A",
      "holiday": "#E26D5A"
    },
    "temple": {
      "skyTop": "#F3B08F",
      "skyBottom": "#FBE3C8",
      "roof": "#6B3A2E",
      "pillar": "#C8553D",
      "wood": "#8A5A3C",
      "woodDark": "#5E3B28",
      "gold": "#E9C46A",
      "lantern": "#E4572E",
      "text": "#FFF3DA",
      "$note": "Chỉ dùng cho màn Đại thiện nhân. Mới thêm 26/9."
    },
    "header": {
      "top": "#3F7F52",
      "bottom": "#74AD80",
      "chip": "#FFFFFFD9",
      "note": "Dải thanh trên, gradient dọc từ primary.base xuống header.bottom, bo 2 góc dưới radius.lg."
    },
    "backdrop": {
      "base": "#DCE8D2",
      "note": "Nền ngoài khung game khi màn rộng hơn 480."
    },
    "nav": {
      "bg": "#FFFFFF",
      "activePill": "#DCEFD9",
      "activeLabel": "#2F6340",
      "label": "#6E6455"
    }
  },
  "font": {
    "family": {
      "display": "Baloo 2",
      "body": "Nunito",
      "note": "Both are Google Fonts with full Vietnamese support. Bundle them as assets (google_fonts package not required)."
    },
    "style": {
      "display": {
        "family": "display",
        "size": 28,
        "weight": 800,
        "lineHeight": 1.1
      },
      "title": {
        "family": "display",
        "size": 20,
        "weight": 700,
        "lineHeight": 1.2
      },
      "heading": {
        "family": "body",
        "size": 16,
        "weight": 800,
        "lineHeight": 1.25
      },
      "body": {
        "family": "body",
        "size": 14,
        "weight": 600,
        "lineHeight": 1.35
      },
      "caption": {
        "family": "body",
        "size": 12,
        "weight": 700,
        "lineHeight": 1.3
      },
      "number": {
        "family": "display",
        "size": 18,
        "weight": 800,
        "lineHeight": 1.0,
        "tabularFigures": true
      },
      "button": {
        "family": "display",
        "size": 16,
        "weight": 700,
        "lineHeight": 1.0
      }
    }
  },
  "space": {
    "xxs": 2,
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 20,
    "pill": 999
  },
  "border": {
    "thin": 1.5,
    "thick": 2.5
  },
  "shadow": {
    "card": {
      "x": 0,
      "y": 4,
      "blur": 0,
      "color": "#BCCDB0",
      "note": "Solid offset shadow (cozy chunky look), not a blur."
    },
    "button": {
      "x": 0,
      "y": 4,
      "blur": 0,
      "color": "pressed",
      "note": "Use the button's own pressed color. On press, translate the button down 4 and drop the shadow."
    },
    "popup": {
      "x": 0,
      "y": 8,
      "blur": 24,
      "color": "#2E3A2C33"
    }
  },
  "size": {
    "touchMin": 44,
    "topBar": 48,
    "button": {
      "height": 48,
      "heightSmall": 36
    },
    "icon": {
      "sm": 16,
      "md": 24,
      "lg": 32
    },
    "trayCard": {
      "width": 72,
      "height": 92
    },
    "avatar": 56,
    "freshnessBar": 4
  },
  "motion": {
    "duration": {
      "fast": 120,
      "base": 200,
      "slow": 320,
      "celebrate": 600
    },
    "easing": {
      "standard": "easeOutCubic",
      "pop": "easeOutBack",
      "exit": "easeInCubic"
    },
    "pattern": {
      "buttonPress": {
        "duration": "fast",
        "easing": "standard",
        "translateY": 4
      },
      "addStem": {
        "duration": "base",
        "easing": "pop",
        "scaleFrom": 0.6,
        "note": "Stem flies from tray card to bouquet, then pops in."
      },
      "popupIn": {
        "duration": "slow",
        "easing": "pop",
        "scaleFrom": 0.85,
        "fadeFrom": 0
      },
      "popupOut": {
        "duration": "base",
        "easing": "exit",
        "scaleTo": 0.95,
        "fadeTo": 0
      },
      "coinGain": {
        "duration": "celebrate",
        "easing": "standard",
        "note": "Coins arc to the top-bar counter, counter ticks up."
      },
      "freshnessTick": {
        "duration": "slow",
        "easing": "standard",
        "note": "Bar color crossfades fresh to aging to wilting."
      }
    }
  }
}