rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Owner UIDs. Keep in sync with supportAdminUids in
    // lib/logic/supporters.dart and adminUids() in storage.rules.
    function adminUids() {
      return ['rFdE3O7LLBZIu0msxtvGktXmfJp1'];
    }

    // An owner UID, or any account with a document at admins/{uid}.
    // Add or remove extra admins only from the Firebase console.
    function isAdmin() {
      return request.auth != null
        && (request.auth.uid in adminUids()
          || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // Game save for the signed-in player: { progress: map, updatedAt }.
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['progress', 'updatedAt'])
        && request.resource.data.progress is map;
    }

    // Đại thiện nhân board: anyone reads. Admins write. The player named
    // on a row (uid) may flip only `visible`.
    match /supporters/{id} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visible'])
          && request.resource.data.visible is bool);
    }

    // Signed-in players, so the admin picker can find a uid. Admin-only read
    // because it holds the email address.
    match /profiles/{uid} {
      allow get, list: if isAdmin();
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'shopName', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.email is string
        && request.resource.data.shopName is string
        && request.resource.data.name.size() < 80
        && request.resource.data.email.size() < 120
        && request.resource.data.shopName.size() < 40;
      allow delete: if false;
    }

    // The player's current portrait. Anyone can read the path; only that
    // player can write it. No email or other profile data.
    match /player_avatars/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['path', 'rev'])
        && request.resource.data.path is string
        && request.resource.data.path.size() > 0
        && request.resource.data.path.size() < 500
        && request.resource.data.rev is int;
      allow delete: if false;
    }

    // Phone numbers and other private notes. Never public.
    match /supporter_private/{id} {
      allow read, write: if isAdmin();
    }

    // Heartbeat. Only a server timestamp, so the settings screen can count
    // who was here in the last minute or so.
    match /presence/{id} {
      allow read: if true;
      allow create, update: if id.size() >= 8
        && id.size() <= 128
        && request.resource.data.keys().hasOnly(['seen'])
        && request.resource.data.seen == request.time;
      allow delete: if false;
    }

    // One document per player, written once, so "đã từng chơi" is a count.
    match /players/{id} {
      allow read: if true;
      allow create: if id.size() >= 8
        && id.size() <= 128
        && request.resource.data.keys().hasOnly(['since'])
        && request.resource.data.since == request.time;
      allow update, delete: if false;
    }

    // Lets the game ask "am I an admin?" without exposing the list.
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, write: if false;
    }
  }
}
