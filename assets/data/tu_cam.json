    },
    {
     "id": "lien_he_duong_dan_02",
     "mau": "(?<!\\d)\\d(?:[\\s\\-_]?\\d){8,}(?!\\d)",
     "kieu": "regex_goc",
     "hanh_dong": "chặn",
     "ghi_chu": "Chuỗi 9+ chữ số viết liền hoặc cách bằng dấu cách/gạch (số tài khoản, số điện thoại viết lạ). Không tính dấu chấm/phẩy để '1.000.000.000 xu' vẫn gửi được."
    },
    {
     "id": "lien_he_duong_dan_03",
     "mau": "(?:https?://|www\\.)\\S+",
     "kieu": "regex_goc",
     "hanh_dong": "chặn",
     "ghi_chu": "Mọi link, kể cả tiemhoasommai.com (xem ghi chú)."
    },
    {
     "id": "lien_he_duong_dan_04",
     "mau": "\\b[a-z0-9][a-z0-9\\-]{1,62}\\s*(?:\\.|\\s(?:chấm|cham|dot)\\s)\\s*(?:com|vn|net|org|info|io|me|xyz|top|site|online|store|shop|link|ly|gg|tk|cc|co|app|dev|biz|club)\\b",
     "kieu": "regex_goc",
     "hanh_dong": "chặn",
     "ghi_chu": "Tên miền kể cả viết 'chấm com'."
    },
    {
     "id": "lien_he_duong_dan_05",
     "mau": "\\b(bit\\.ly|tinyurl|shorturl|cutt\\.ly|t\\.me|zalo\\.me|fb\\.me|m\\.me|wa\\.me|discord\\.gg)\\b",
     "kieu": "regex_goc",
     "hanh_dong": "chặn",
     "ghi_chu": "Link rút gọn, link mời."
    },
    {
     "id": "lien_he_duong_dan_06",
     "mau": "[a-z0-9._%+\\-]+@[a-z0-9.\\-]+\\.[a-z]{2,}",
     "kieu": "regex_goc",
     "hanh_dong": "chặn",
     "ghi_chu": "Email."
