{
  "version": "0.2-draft",
  "_status": "DRAFT for An's review. First pass, calibrated with sim.py (see sim_report.md). Tune after playtest.",
  "_conventions": "camelCase keys. Money = whole VND. Time = real seconds unless the key ends in Days. Fractions are 0..1. Keys starting with _ are comments; the game ignores them.",
  "currency": "VND",
  "start": {
    "cash": 500000,
    "rating": 4.0,
    "unlockedFlowers": [
      "rose",
      "daisy",
      "baby"
    ],
    "unlockedPapers": [
      "kraft"
    ],
    "unlockedRibbons": [
      "twine"
    ]
  },
  "day": {
    "realSeconds": 240,
    "openHour": 8,
    "closeHour": 20,
    "_note": "12 in-game hours in 240 s (1 in-game hour = 20 s). Morning market and end-of-day summary are untimed.",
    "fixedCosts": {
      "rent": 40000,
      "utilities": 15000
    },
    "arrivalWeightsByHour": {
      "8": 0.8,
      "9": 0.8,
      "10": 0.7,
      "11": 1.0,
      "12": 1.1,
      "13": 0.6,
      "14": 0.6,
      "15": 0.8,
      "16": 1.0,
      "17": 1.4,
      "18": 1.4,
      "19": 1.0
    }
  },
  "customers": {
    "baseCustomersDay1": 8,
    "growthPerDay": 0.25,
    "baseCustomersCap": 14,
    "_formula": "expected = min(cap, baseCustomersDay1 + growthPerDay*(day-1)) * ratingFactor(rating) * product(upgrade customerMultiplier) * holiday.customerMultiplier * priceDemandFactor. Actual count = Poisson(expected), arrival times spread by arrivalWeightsByHour.",
    "ratingFactor": {
      "1": 0.6,
      "2": 0.75,
      "3": 0.9,
      "4": 1.0,
      "5": 1.2
    },
    "_ratingFactorNote": "Linear between whole stars.",
    "ratingWindow": 20,
    "reviewStars": {
      "great": 5,
      "okay": 4,
      "unhappy": 3,
      "leftUnserved": 2,
      "walkedPast": null,
      "onlineMissed": 1
    },
    "_ratingNote": "Shop rating (1-5) = average reviewStars of the last ratingWindow customers. leftUnserved = waited then left (patience ran out). walkedPast = arrived while the queue was full and left at once; null = no review (so busy holidays do not wreck the rating).",
    "patienceSeconds": 50,
    "patienceWarningAt": 0.3,
    "walkInSeconds": 3,
    "counterSlots": 1,
    "maxQueue": 4,
    "_queueNote": "Arrivals when counterSlots+maxQueue are full leave at once (walkedPast)."
  },
  "pricing": {
    "_formula": "bouquetPrice = roundTo1000((sum(stems * flower.sellPrice) + paper.sellPrice + ribbon.sellPrice) * priceMultiplier)",
    "priceMultiplier": {
      "min": 0.8,
      "max": 1.5,
      "default": 1.0,
      "step": 0.1
    },
    "priceDemandFactor": {
      "_formula": "mult > 1: customers * (1 - aboveSlope*(mult-1)) and patience * (1 - patienceSlope*(mult-1)). mult < 1: customers * (1 + belowSlope*(1-mult)).",
      "aboveSlope": 0.8,
      "belowSlope": 0.4,
      "patienceSlope": 0.5
    }
  },
  "bouquet": {
    "maxStems": 15,
    "_maxStemsNote": "Hard cap on stems in one bouquet, filler (baby) included. Order generators never ask for more.",
    "matchThresholds": {
      "okay": 0.5,
      "great": 0.85
    },
    "_thresholdNote": "match < okay = unhappy; okay <= match < great = okay; match >= great = great.",
    "tiers": {
      "unhappy": {
        "payFactor": 0.8,
        "tipPercent": 0.0
      },
      "okay": {
        "payFactor": 1.0,
        "tipPercent": 0.03
      },
      "great": {
        "payFactor": 1.0,
        "tipPercent": 0.1
      }
    },
    "_tierNote": "Customer pays bouquetPrice * payFactor. Tip = bouquetPrice * tipPercent * holiday.tipMultiplier * occasion.tipMultiplier, rounded to 1000. Wrapping bonus (wrapMiniGame) is added on top for every tier.",
    "fastServiceBonusPercent": 0.05,
    "fastServiceThreshold": 0.5,
    "_fastNote": "Extra tip percent if the bouquet is handed over before fastServiceThreshold of patience is used. Only for okay/great."
  },
  "matchScoring": {
    "weights": {
      "species": 0.5,
      "stemCount": 0.2,
      "paper": 0.15,
      "ribbon": 0.15
    },
    "_formula": "match = sum(weight_i * score_i), each score_i in 0..1, then minus wiltingPenalty if used, clamp 0..1.",
    "species": {
      "_rule": "R = requested species (excluding filler unless the customer asked for it), U = species used (excluding filler if fillerAllowed). score = |R∩U|/|R| - wrongSpeciesPenalty * |U - R|, clamp 0..1.",
      "wrongSpeciesPenalty": 0.25,
      "fillerSpecies": [
        "baby"
      ]
    },
    "stemCount": {
      "_rule": "Compare total stems of requested species (filler excluded) with the requested total. Credit by absolute difference; 3 or more off = 0.",
      "creditByDifference": {
        "0": 1.0,
        "1": 0.6,
        "2": 0.3
      }
    },
    "paper": {
      "exact": 1.0,
      "otherAcceptedForOccasion": 0.5,
      "other": 0.0
    },
    "ribbon": {
      "exact": 1.0,
      "otherAcceptedForOccasion": 0.5,
      "other": 0.0
    },
    "wiltingPenalty": 0.15,
    "_wiltNote": "Subtracted once if any stem in the bouquet is on its last fresh day (freshnessLeft = 1). Shown as a small wilted icon on the stem."
  },
  "wrapMiniGame": {
    "_how": "After picking paper and ribbon the player holds to fill a bar and releases inside the green zone. REWARD-ONLY: a miss still sells the bouquet normally at its tier; only the bonus tip is lost.",
    "fillSeconds": 1.4,
    "_fillNote": "Time to fill the bar from 0 to 1 while holding. Holding past full counts as a miss.",
    "greenZone": {
      "baseWidth": 0.24,
      "narrowPerRank": 0.02,
      "minWidth": 0.14,
      "centerRange": [
        0.5,
        0.8
      ],
      "_formula": "width = max(minWidth, baseWidth - narrowPerRank*(shopRank-1)) + wrappingTable.greenZoneBonus. Center picked uniformly in centerRange per bouquet; zone clamped inside 0..1."
    },
    "bonusTip": {
      "percentOfPrice": 0.08,
      "minAmount": 2000
    },
    "_bonusNote": "Hit = release while fill is inside the zone. Bonus = max(minAmount, roundTo1000(bouquetPrice * percentOfPrice)), paid on top of the tier tip, all tiers.",
    "wrapAnimationSeconds": 2.5,
    "_upgradeNote": "The wrapping_table upgrade widens the green zone (greenZoneBonus) and shortens the wrap animation after release (wrapTimeReduction). fillSeconds does not change."
  },
  "shopRanks": [
