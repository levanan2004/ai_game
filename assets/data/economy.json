  "_occasionNote": "Spawns only if unlockWhen (a flower/paper/ribbon id) is owned. The request picks 1-2 species from 'species' that are unlocked (fallback rose/daisy), a stem total from stemOptions or stemRange, and 1 paper + 1 ribbon from the lists that are unlocked (fallback kraft/twine). If fillerAllowed, 50% of requests add 2 stems of one owned filler (fillerSpecies). Total never exceeds bouquet.maxStems.",
  "delivery": {
    "_how": "Online orders + 3 shippers. Replaces the old unused upgrades.online and top-level onlineOrders keys. Two kinds of online order share one flow and one set of rules. PREORDER (đặt trước): shown on the morning board before the market; the player accepts/declines each card, buys stems at the market, then packs them at the bouquet table during the untimed morning prep. SAMEDAY (đặt trong ngày): pops in during open hours; the player taps Nhận within acceptSeconds (ignored = gone, no penalty) and packs it at the table between walk-ins. Every packed bouquet goes to the dispatch shelf and is auto-assigned to the shipper who can hand it over soonest -> the shipper leaves (at once if full, else after loadWaitSeconds) -> hands it over after deliverSeconds (+extraStopSeconds per earlier stop on the same trip) -> is back after returnSeconds. Paid on hand-over. Preorders are the shippers' main job (no walk-in time used); sameday orders trade walk-in time for the online premium.",
    "unlock": {
      "rule": "firstShipperHired",
      "_note": "No online orders at all until the first shipper (bike, can be hired from day 3) is hired; they start the next morning. Show a teaser card on day 3."
    },
    "orders": {
      "perDay": {
        "base": 1.0,
        "perRank": 0.1,
        "holidayMultiplier": 1.3,
        "cap": 6
      },
      "_perDayFormula": "expected = min(cap, base + perRank*(shopRank-1) + sum(hired shipper.demandBonusPerDay)) * ratingFactor(rating) * (holidayMultiplier on holidays). Computed each morning. More shippers = wider delivery area = more people order.",
      "preorder": {
        "share": 0.7,
        "deadlineHours": [
          11,
          13,
          15,
          17,
          19
        ],
        "maxBoard": 6,
        "_note": "Morning board: Poisson(expected * share) cards, at most maxBoard. Each card's deadline = start of a random hour from deadlineHours (11 -> real second 60 ... 19 -> 220). Accepted cards must be packed before or during the day; the board shows a green/red hint per card: can the current shippers make that deadline if accepted (simulate the auto-assign rule)."
      },
      "sameday": {
        "share": 0.3,
        "spawnHours": [
          8,
          16
        ],
        "acceptSeconds": 20,
        "deadlineSeconds": 120,
        "maxPending": 3,
        "_note": "Spawn only while the in-game hour is within spawnHours (inclusive: 08:00-16:59 = real seconds 0..180). Each real second, P(spawn) = expected * share * w(hour) / (sum of w over spawnHours * secondsPerHour), w = day.arrivalWeightsByHour, secondsPerHour = 20. deadline = min(spawnTime + deadlineSeconds, day.realSeconds). maxPending counts sameday orders incoming or accepted-but-not-dispatched; while it is reached, spawns are skipped silently."
      },
      "acceptRequiresStock": true,
      "_acceptNote": "Sameday: the Nhận button is disabled (shows the missing stems) unless every stem is in stock. Preorder: accepting adds the stems to the market shopping list; a preorder whose stems were not bought is auto-cancelled at opening with no penalty. Accepting (or packing a preorder) reserves the stems so walk-ins cannot use them; if the order is cancelled before packing they go back to stock.",
      "stemRange": [
        5,
        10
      ],
      "_bouquetNote": "Occasion, species, paper and ribbon are picked exactly like a walk-in (occasions + holiday occasionBias + unlockWhen), but the stem total comes from stemRange (filler wish still possible, total <= bouquet.maxStems). Order text: orders.json online.preorder / online.sameday lines. No patience timer; the deadline replaces it. The card shows a countdown (sameday) or the deadline hour (preorder)."
    },
    "payment": {
      "deliveryFee": 25000,
      "onlinePriceMultiplier": 1.2,
      "_formula": "On-time delivery pays roundTo1000(bouquetPrice * tier.payFactor * onlinePriceMultiplier) + tip + deliveryFee, where tip = roundTo1000((bouquetPrice * tier.tipPercent * holiday/occasion tipMultiplier + wrap mini-game bonus) * onlinePriceMultiplier). NO fast-service bonus for online orders. onlinePriceMultiplier = the online menu price (card + gift wrap included); the shop's walk-in priceMultiplier does not apply to online orders. Review = the bouquet's tier (great/okay/unhappy). Paper/ribbon cost and stems are consumed when packed."
    },
    "late": {
      "payFactor": 0.5,
      "deliveryFee": 0,
      "tip": 0,
      "review": "onlineMissed",
      "_note": "Dispatched but handed over after the deadline: customer pays roundTo1000(bouquetPrice * payFactor), no fee, no tip, 1-star onlineMissed review."
    },
    "missed": {
      "moneyPenalty": 0,
      "review": "onlineMissed",
      "_note": "Accepted but not dispatched by the deadline (or still waiting at close): the order is cancelled, 1-star onlineMissed review, no payment, no fine. A bouquet already packed for it is thrown away. Ignoring an incoming order (not accepting) has no penalty and no review."
    },
    "assignment": {
      "autoAssign": true,
      "loadWaitSeconds": 5,
      "extraStopSeconds": 5,
      "_rule": "Auto-assign each packed bouquet to the shipper that would hand it over earliest: a shipper at the shop with room on a trip that has not left yet, else the one returning soonest (ties: lower id order in the list). A shipper at the shop departs when full or loadWaitSeconds after its first bouquet; the player may tap 'Đi giao' to send it at once. Orders on one trip are handed over in load order, each extra stop adds extraStopSeconds before the next hand-over and before returning. Trips still running at close finish during the end-of-day summary (late rules still apply)."
    },
